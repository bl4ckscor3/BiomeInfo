{
  "schemaVersion": 1,
  "id": "biomeinfo",
  "version": "${version}",

  "name": "BiomeInfo",
  "description": "Displays the name of the current biome on screen.",
  "authors": [
    "bl4ckscor3"
  ],
  "contact": {
    "homepage": "https://curseforge.com/minecraft/mc-mods/biomeinfo-fabric",
    "issues": "https://github.com/bl4ckscor3/BiomeInfo/issues",
    "sources": "https://github.com/bl4ckscor3/BiomeInfo/tree/fabric/1.21.11"
  },

  "license": "MIT",
  "icon": "assets/biomeinfo/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "bl4ckscor3.mod.biomeinfo.BiomeInfo"
    ],
    "modmenu": [
      "bl4ckscor3.mod.biomeinfo.ModMenuIntegration"
    ]
  },

  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": ">=26",
    "java": ">=25",
    "cloth-config": ">=26.1"
  },
  "custom": {
    "modmenu:clientsideOnly": true
  }
}